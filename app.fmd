[App Name] Wedding Planner

[Display] Home
  [Title] Wedding Planner
  [TopMenu] Home, Schedule, Inventory, Vendors, Budget, Vendor Detail
  [Main]
    ((Schedule Timeline)
        [Button -> Event] New Event
        [Table -> Schedule] Time, Activity
    (Inventory Counts)
        [Counter -> Inventory] Category
            [Count] Folding Chairs
            [Count] Round Tables
            [Counts] Centerpieces, String Lights
    )
    ((Vendor Checklist)
        [Button -> Approve All Vendors] Approve All Vendors
        [Checklist -> Vendors] Name / Status
    (Budget Summary)
        [Slider -> Budget] Category Spent / Cap
            [Slide] Venue
            [Slide] Catering
            [Slides] Photography, Flowers
    )
[Display] Schedule
    [cTable -> Schedule] Time, Activity, Vendor, VendorStatus   # VendorStatus is a [Lookup]

[Display] Budget
    [Title] Budget
    [Main]
      ((Budget by Status)
        [Table -> Budget] Category, Spent, Cap, Remaining, Pace   # Remaining/Pace are [Calc]
          [Sort] Spent desc
          [Group] Pace
          [Foot] sum Spent, sum Cap, count
      )

[Display] Vendor Detail
    [Title] Vendor Detail
    [Main]
      ((Vendor)
        [Detail -> Vendors] Name, Status
          [Table -> Schedule ? Vendor == this.Name] Time, Activity
      )

[Form -> Schedule] New Event
    [Field "Start of Event" ()] Time
    [Fields] Activity, Vendor

[Rule] IsApprovedVendor (Status == True)

[Action] Approve All Vendors
  [Update -> Vendors ? Status == False] Status = true

[Data]
  [List Schedule] txtTime, txtActivity, linkVendor
  (Vendors) -> Vendors Name ? Status
  [Lookup] VendorStatus = Vendor.Status          # pull the vendor's Status onto each row
  [Store Inventory] txtTitle, dropCategory, numCount, curPrice, txtRelated txtVendor
  [List Vendors] txtName, boolStatus
  [List Budget] dropCategory, curSpent, curCap, dateDeadline, curRemaining, txtPace
  (Category) Venue, Catering, Photography, Flowers
  [Calc] Remaining = Cap - Spent
  [Calc] Pace = if(Spent > Cap, "over", "ok")
  [List Venue] txtName, txtLocation, curPrice, numCapacity

  